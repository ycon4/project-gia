import React, { useMemo } from 'react';
import { 
  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, Cell 
} from 'recharts';
import { ShieldAlert, Wallet, Globe, Users } from 'lucide-react';

export default function GraduateVisuals({ data }) {
  
  // 1. Sector Population Summary (Students vs Employees)
  const populationSummary = useMemo(() => {
    const students = data.filter(d => d.sector?.toLowerCase().includes('student'));
    const employees = data.filter(d => d.sector?.toLowerCase().includes('faculty') || d.sector?.toLowerCase().includes('staff') || d.sector?.toLowerCase().includes('employee'));
    
    return {
      students: students.length,
      employees: employees.length,
      total: data.length
    };
  }, [data]);

  // 2. Vulnerability SDD (Stacked Bar)
  const vulnerabilitySDD = useMemo(() => {
    const counts = data.reduce((acc, curr) => {
      const status = curr.Vulnerability_status || 'Not Declared';
      if (!acc[status]) acc[status] = { name: status, Male: 0, Female: 0 };
      const sex = curr.normalizedSex === 'Female' ? 'Female' : 'Male';
      acc[status][sex]++;
      return acc;
    }, {});
    return Object.values(counts);
  }, [data]);

  // 3. PSA Income Level Breakdown
  const incomeSDD = useMemo(() => {
    const counts = data.reduce((acc, curr) => {
      const level = curr.PSA_income_level || 'Unknown';
      if (!acc[level]) acc[level] = { name: level, Male: 0, Female: 0 };
      const sex = curr.normalizedSex === 'Female' ? 'Female' : 'Male';
      acc[level][sex]++;
      return acc;
    }, {});
    return Object.values(counts);
  }, [data]);

  return (
    <div className="space-y-6 animate-in fade-in slide-in-from-bottom-2 duration-500">
      
      {/* 4. Population Cards (Specific Objective 1 Fulfillment) */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <StatCard label="Total Students" value={populationSummary.students} icon={<Users className="text-purple-500" size={16}/>} />
        <StatCard label="Total Employees" value={populationSummary.employees} icon={<Users className="text-blue-500" size={16}/>} />
        <StatCard label="Grand Total (SDD)" value={populationSummary.total} icon={<Globe className="text-orange-500" size={16}/>} />
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        {/* Vulnerability SDD Chart */}
        <VisualCard title="Vulnerability Status SDD" icon={<ShieldAlert size={18} className="text-red-500"/>}>
          <div className="h-72">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={vulnerabilitySDD}>
                <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f3f4f6" />
                <XAxis dataKey="name" fontSize={10} fontWeight="bold" />
                <YAxis fontSize={10} axisLine={false} tickLine={false} />
                <Tooltip cursor={{fill: '#f8fafc'}} />
                <Legend iconType="circle" />
                <Bar dataKey="Female" stackId="a" fill="#f472b6" radius={[0, 0, 0, 0]} />
                <Bar dataKey="Male" stackId="a" fill="#60a5fa" radius={[4, 4, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </VisualCard>

        {/* PSA Income Chart */}
        <VisualCard title="PSA Income Level SDD" icon={<Wallet size={18} className="text-green-500"/>}>
          <div className="h-72">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={incomeSDD} layout="vertical">
                <CartesianGrid strokeDasharray="3 3" horizontal={false} stroke="#f3f4f6" />
                <XAxis type="number" fontSize={10} hide />
                <YAxis dataKey="name" type="category" fontSize={9} width={90} axisLine={false} />
                <Tooltip />
                <Legend iconType="circle" />
                <Bar dataKey="Female" fill="#f472b6" radius={[0, 4, 4, 0]} />
                <Bar dataKey="Male" fill="#60a5fa" radius={[0, 4, 4, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </VisualCard>

      </div>

      {/* Ethnicity Diversity Summary */}
      <VisualCard title="Ethnicity Distribution" icon={<Globe size={18} className="text-orange-500"/>}>
        <div className="flex flex-wrap gap-2">
          {Array.from(new Set(data.map(d => d.Ethnicity))).filter(Boolean).map(eth => (
            <div key={eth} className="px-4 py-2 bg-gray-50 border rounded-xl flex items-center gap-3 print:border-gray-300">
              <span className="text-xs font-black text-gray-700">{eth}</span>
              <span className="px-2 py-0.5 bg-white border rounded text-[10px] font-bold text-purple-600">
                {data.filter(d => d.Ethnicity === eth).length}
              </span>
            </div>
          ))}
        </div>
      </VisualCard>

      {/* Signature Section - Only visible in Print */}
      <div className="hidden print:grid grid-cols-2 gap-20 mt-16 pt-10 border-t border-gray-300">
        <div className="text-center">
          <div className="border-b border-black w-48 mx-auto mb-2"></div>
          <p className="text-[10px] font-black uppercase">Prepared By</p>
        </div>
        <div className="text-center">
          <div className="border-b border-black w-48 mx-auto mb-2"></div>
          <p className="text-[10px] font-black uppercase">GADC Director / Authorized Personnel</p>
        </div>
      </div>
    </div>
  );
}

